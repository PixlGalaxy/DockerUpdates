# Most of these values can also be changed in the web UI (Settings > Account and
# Settings > Server & access). A value saved there takes precedence over this file.

# Login credentials (required). The app refuses to start with a weak/default password:
# use 12+ characters. Once you change the username or password in Settings > Account,
# those are used instead.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Forgot the username or password set in the web UI? Set this to true and recreate the
# container: the login from Settings is deleted and ADMIN_USER / ADMIN_PASSWORD above
# work again. Set it back to false afterwards, otherwise every restart resets it.
RESET_LOGIN_CONFIG=false

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random one is used and sessions reset on every restart.
SESSION_SECRET=

# Session lifetime in hours, and logout after this many idle minutes.
# Initial values only: they can be changed later in Settings > Login & sessions.
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120

# --- Reverse proxy (Nginx Proxy Manager) ---
# IP of the proxy allowed to set X-Forwarded-For / X-Forwarded-Proto (client IP for the
# login lockout, HTTPS detection). Set it to your NPM IP so other LAN hosts can't spoof them.
# Default: loopback + private networks (a warning is printed and the login lockout also
# counts the connecting address; behind a proxy, set this so users are not locked out together).
# TRUST_PROXY=192.168.0.155
# Always mark the session cookie Secure (set to true when you only use it through HTTPS)
# COOKIE_SECURE=true
# Extra origins allowed to call the API. Normally empty: the app only accepts its own origin.
# ALLOWED_ORIGINS=https://docker.example.com

# Server port
PORT=3000

# Optional: IP shown in the header and the "LAN IP:Port" column. Auto-detected from the server's
# default network interface (also when it changes); set it only to choose another address of the
# server. A value that is not an address of this server is ignored (with a warning in the logs).
HOST_IP=
# Optional: server name shown in the header (defaults to the Docker host's hostname)
# HOST_NAME=

# Optional: credentials for private registries, used when pulling updates.
# By default DockerUpdates reuses the host's `docker login` if you mount it:
#   -v ~/.docker/config.json:/root/.docker/config.json:ro
# Use this instead if your login uses a credential helper (credsStore) or you prefer env vars.
# Format: registry=user:token, comma separated. Use a token with read-only access (read:packages).
# REGISTRY_AUTH=ghcr.io=PixlGalaxy:ghp_xxx,docker.io=myuser:dckr_pat_xxx

# Optional: Docker connection (defaults to the platform socket / named pipe)
# DOCKER_HOST=tcp://192.168.0.150:2375
# DOCKER_SOCKET=/var/run/docker.sock
